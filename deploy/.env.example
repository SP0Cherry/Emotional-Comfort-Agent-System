# Development only. scripts/start-dev.ps1 generates separate local secrets.
# Keep database password URL-safe, or URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=change-this-development-password
POSTGRES_PORT=5432
API_BIND=127.0.0.1
APP_ENV=development
DATABASE_URL=postgresql+psycopg://companion_dev:change-this-development-password@127.0.0.1:5432/companion
SECRET_KEY=development-only-change-this-secret-before-deployment
PHONE_ENCRYPTION_KEY=development-only-separate-phone-encryption-key

# mock: reproducible local responses, no paid cloud requests.
# live: supply matching region/workspace credentials from the provider console.
PROVIDER_MODE=mock
DASHSCOPE_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
LOCAL_STORAGE_DIR=./storage
WORKER_CONCURRENCY=4
LEASE_SECONDS=90
GENERATION_TIMEOUT_SECONDS=45
RUN_TIMEOUT_SECONDS=60
MAX_USER_DAILY_RUNS=100
